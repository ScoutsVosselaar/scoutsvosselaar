---
interface Props {
  title: string;
  id?: string;
}
const { title, id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-') } = Astro.props;
---

<section aria-labelledby={title ? id : undefined} class="grid gap-x-10 gap-y-2 border-t-2 border-ink pt-5 md:grid-cols-[14rem_1fr]">
  {title ? <h2 id={id} class="text-2xl sm:text-3xl">{title}</h2> : <div />}
  <div class="prose"><slot /></div>
</section>
