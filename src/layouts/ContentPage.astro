---
/** Fixed page with a dark intro and readable text. */
import BaseLayout from './BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { site } from '@/site.config';
import { contentWarning } from '@/lib/log';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

if (!site.address.street) contentWarning('Vaste gegevens ontbreken in src/site.config.ts (niet getoond): site.address.street');
---

<BaseLayout title={title} description={description}>
  <PageIntro title={title}><slot name="intro" /></PageIntro>
  <div class="wrap py-12">
    <div class="max-w-5xl space-y-10">
      <slot />
    </div>
  </div>
</BaseLayout>
